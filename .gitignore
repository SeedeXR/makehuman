# Merge conflicts #
###################
*.orig

# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Ignore Python Byte-compiled / optimized / DLL files #
#######################################################
__pycache__/
*.py[cod]
*$py.class
*.bak
*.npz

# data files for MakeHuman  Project #
#####################################
*.obj
*.png
*.thumb
*.mhclo
*.mhmat
*.mhpose
*.meta
*.mhuv
*.mhw
*.proxy
*.mhpxy
*.list
*.bvh
*.mhskel
# (data/ moved to the repo root in the 2026-08-29 restructure and is tracked)
#
# Those asset-extension rules predate the move and would now silently drop
# anything new under data/ -- the generated mixamo_superset.mhskel was ignored
# on creation, which would have failed the CI staleness gate on its first run
# because the file was never committed. The tracked assets only survive because
# they were added before the rules. Everything under data/ is repo content.
!data/**
base_1-1_contents.txt

# Pydev Eclipse#
################
.project
.pydevproject
.settings/

# PyCharm #
###########
.idea/

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
/venv*

# macOS Build Files #
#####################
/buildscripts/darwin/build/*
/buildscripts/darwin/dist/*
/buildscripts/darwin/.eggs/*

# Python Packages #
###################
.eggs/*

# --- C++/Qt6 port ---
build/
build-*/
cmake-build-*/
.cache/
compile_commands.json
*.qsb

# reference oracle venv (Python, dev only)
.venv-mh/

# graphify knowledge graph: keep the report, not the 5 MB raw graph
graphify-out/graph.json
graphify-out/cache/
graphify-out/.graphify_*

# benchmark run outputs (the committed baseline is benchmarks/baseline_python.json)
benchmarks/results/

# macOS
.DS_Store
*.dSYM/

# references/ holds third-party input used only as a naming reference and as
# import test data (see LICENSING.md 5.4). Build outputs from it never belong
# in the repository.
references/**/*.blend
references/**/*.abc
